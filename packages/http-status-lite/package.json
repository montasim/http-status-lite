{
    "name": "http-status-lite",
    "version": "2.3.0",
    "description": "Tiny, standards-backed, type-safe HTTP status codes for Node.js and browsers",
    "type": "module",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./codes": {
            "import": {
                "types": "./dist/codes.d.ts",
                "default": "./dist/codes.js"
            },
            "require": {
                "types": "./dist/codes.d.cts",
                "default": "./dist/codes.cjs"
            }
        },
        "./predicates": {
            "import": {
                "types": "./dist/predicates.d.ts",
                "default": "./dist/predicates.js"
            },
            "require": {
                "types": "./dist/predicates.d.cts",
                "default": "./dist/predicates.cjs"
            }
        },
        "./metadata": {
            "import": {
                "types": "./dist/metadata.d.ts",
                "default": "./dist/metadata.js"
            },
            "require": {
                "types": "./dist/metadata.d.cts",
                "default": "./dist/metadata.cjs"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE",
        "SECURITY.md"
    ],
    "sideEffects": false,
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "generate": "node scripts/generate-registry.mjs",
        "generate:check": "node scripts/generate-registry.mjs --check",
        "registry:update": "node scripts/update-registry.mjs && pnpm generate",
        "typecheck": "tsc --noEmit",
        "test:runtime": "node --test test/*.test.js",
        "test:size": "node scripts/check-size.mjs",
        "test:package": "node scripts/test-package.mjs",
        "test": "pnpm generate:check && pnpm typecheck && pnpm build && pnpm test:runtime && pnpm test:size",
        "test:all": "pnpm test && pnpm test:package",
        "prepack": "pnpm test",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "pnpm lint && pnpm format:check && pnpm test:all"
    },
    "keywords": [
        "http",
        "http-status",
        "http-status-code",
        "http-status-codes",
        "status-code",
        "status-codes",
        "reason-phrase",
        "iana",
        "rfc-9110",
        "typescript",
        "type-safe",
        "fetch",
        "nodejs",
        "browser",
        "esm",
        "commonjs",
        "zero-dependency",
        "lightweight"
    ],
    "author": "Montasim",
    "license": "MIT",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/montasim/http-status-lite.git",
        "directory": "packages/http-status-lite"
    },
    "bugs": {
        "url": "https://github.com/montasim/http-status-lite/issues"
    },
    "homepage": "https://http-status-lite.netlify.app/",
    "devDependencies": {
        "eslint": "9.39.2",
        "eslint-config-prettier": "10.1.8",
        "prettier": "3.8.1",
        "tsup": "8.5.1",
        "typescript": "5.9.3",
        "typescript-eslint": "8.57.2"
    }
}

{
    "name": "http-status-lite-workspace",
    "version": "2.3.0",
    "private": true,
    "description": "http-status-lite library and interactive documentation workspace.",
    "license": "MIT",
    "homepage": "https://http-status-lite-demo.netlify.app/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/montasim/http-status-lite.git"
    },
    "bugs": {
        "url": "https://github.com/montasim/http-status-lite/issues"
    },
    "packageManager": "pnpm@11.7.0",
    "engines": {
        "node": ">=20.19.0"
    },
    "scripts": {
        "dev": "pnpm dev:web",
        "dev:web": "pnpm --filter http-status-lite build && pnpm --filter @http-status-lite/web dev",
        "build": "pnpm --filter @http-status-lite/web... build",
        "build:package": "pnpm --filter http-status-lite build",
        "build:web": "pnpm --filter @http-status-lite/web... build",
        "check": "pnpm check:package && pnpm --filter @http-status-lite/web check",
        "check:package": "pnpm --filter http-status-lite check",
        "check:web": "pnpm --filter http-status-lite build && pnpm --filter @http-status-lite/web check",
        "test": "pnpm --filter http-status-lite test",
        "test:all": "pnpm --filter http-status-lite test:all",
        "registry:update": "pnpm --filter http-status-lite registry:update",
        "generate": "pnpm --filter http-status-lite generate",
        "generate:check": "pnpm --filter http-status-lite generate:check",
        "format": "pnpm --recursive --if-present format",
        "format:check": "pnpm --recursive --if-present format:check",
        "prepare": "husky"
    },
    "devDependencies": {
        "@commitlint/cli": "20.5.0",
        "@commitlint/config-conventional": "20.5.0",
        "husky": "9.1.7",
        "lint-staged": "16.4.0",
        "prettier": "3.8.1",
        "typescript": "5.9.3"
    }
}

{
    "name": "@http-status-lite/web",
    "version": "2.0.0",
    "description": "Interactive, SSR-rendered TypeScript reference for http-status-lite and all 64 IANA HTTP status codes",
    "private": true,
    "license": "MIT",
    "author": "Montasim",
    "homepage": "https://http-status-lite-demo.netlify.app/",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/montasim/http-status-lite.git",
        "directory": "apps/web"
    },
    "bugs": {
        "url": "https://github.com/montasim/http-status-lite/issues"
    },
    "keywords": [
        "http",
        "http-status",
        "http-status-code",
        "http-status-codes",
        "http-status-lite",
        "status-code",
        "status-codes",
        "iana",
        "rfc-9110",
        "typescript",
        "type-safe",
        "developer-tools",
        "documentation",
        "reference",
        "tanstack-start",
        "tanstack-router",
        "react",
        "tailwindcss",
        "shadcn-ui",
        "server-side-rendering"
    ],
    "engines": {
        "node": ">=20.19.0"
    },
    "type": "module",
    "imports": {
        "#/*": "./src/*"
    },
    "scripts": {
        "dev": "vite dev --port 3000",
        "generate-routes": "tsr generate",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit",
        "format": "prettier --write . && eslint --fix",
        "format:check": "prettier --check .",
        "check": "pnpm generate-routes && pnpm format:check && pnpm lint && pnpm typecheck && pnpm build"
    },
    "dependencies": {
        "@fontsource-variable/geist": "^5.3.0",
        "@tailwindcss/vite": "^4.1.18",
        "@tanstack/react-router": "1.170.18",
        "@tanstack/react-start": "1.168.34",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "http-status-lite": "workspace:*",
        "lucide-react": "^1.28.0",
        "radix-ui": "^1.6.7",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "shadcn": "^4.16.1",
        "tailwind-merge": "^3.6.0",
        "tailwindcss": "^4.1.18",
        "tw-animate-css": "^1.4.0"
    },
    "devDependencies": {
        "@netlify/vite-plugin-tanstack-start": "1.3.17",
        "@tanstack/eslint-config": "0.4.0",
        "@tanstack/router-cli": "^1.132.0",
        "@types/node": "^22.10.2",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.0.1",
        "eslint": "^10.0.0",
        "prettier": "3.8.1",
        "typescript": "5.9.3",
        "vite": "^8.0.0"
    }
}
